extends RefCounted
## Shared look and small widget helpers. Usage: const UI = preload("res://scripts/ui/ui_util.gd")

const Tokens = preload("res://ui/style/tokens.gd")
const Icons = preload("res://ui/style/icons.gd")

const BG := Tokens.BG
const BG_DARK := Tokens.BG_DARK
const BG_CARD := Tokens.BG_CARD
const BORDER := Tokens.BORDER
const TEXT := Tokens.TEXT
const TEXT_DIM := Tokens.TEXT_DIM
const GOLD := Tokens.GOLD
const GOOD := Tokens.GOOD
const BAD := Tokens.BAD
const DOOM := Tokens.DOOM
const INFO := Tokens.INFO
const WARN := Tokens.WARN


static func box(bg: Color = BG, border: Color = BORDER, radius: int = Tokens.RADIUS, pad: int = 10) -> StyleBoxFlat:
	var sb = StyleBoxFlat.new()
	sb.bg_color = bg
	sb.border_color = border
	sb.set_border_width_all(Tokens.BORDER_W)
	sb.set_corner_radius_all(radius)
	sb.set_content_margin_all(pad)
	sb.anti_aliasing = radius > 0
	return sb


static func tex_box(file: String, margin: int, pad_h: float, pad_v: float, tile: bool = false) -> StyleBoxTexture:
	## A nine-patch from assets/ui (generated by tools/make_ui_art.py).
	var sb = StyleBoxTexture.new()
	sb.texture = load("res://assets/ui/" + file)
	sb.set_texture_margin_all(margin)
	sb.content_margin_left = pad_h
	sb.content_margin_right = pad_h
	sb.content_margin_top = pad_v
	sb.content_margin_bottom = pad_v
	if tile:
		sb.axis_stretch_horizontal = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
		sb.axis_stretch_vertical = StyleBoxTexture.AXIS_STRETCH_MODE_TILE_FIT
	return sb


static func _svg_tex(svg: String, px: int) -> Texture2D:
	var img = Image.new()
	img.load_svg_from_string(svg, px / 16.0)
	return ImageTexture.create_from_image(img)


static func build_theme() -> Theme:
	var t = Theme.new()
	t.default_font = Tokens.font("medium")
	t.default_font_size = Tokens.SIZE_BODY
	t.set_color("font_color", "Label", TEXT)
	t.set_color("font_outline_color", "Label", Tokens.INK)
	# windows and surfaces
	t.set_stylebox("panel", "PanelContainer", tex_box("panel.png", 12, 16, 14, true))
	t.set_stylebox("panel", "Panel", tex_box("panel.png", 12, 16, 14, true))
	for v in [["TopBarPanel", tex_box("topbar.png", 4, 12, 6)], ["CardPanel", tex_box("card.png", 6, 10, 8, true)],
			["InkPanel", tex_box("tooltip.png", 6, 10, 8, true)], ["BarPanel", tex_box("panel.png", 12, 8, 8, true)]]:
		t.set_type_variation(v[0], "PanelContainer")
		t.set_stylebox("panel", v[0], v[1])
	# buttons: every state, including focus for keyboard users
	var focus = box(Color(0, 0, 0, 0), Tokens.GOLD_HI, Tokens.RADIUS, 0)
	focus.draw_center = false
	focus.set_expand_margin_all(1)
	for cls in ["Button", "OptionButton", "CheckBox", "MenuButton"]:
		var plain = cls == "CheckBox"
		t.set_stylebox("normal", cls, StyleBoxEmpty.new() if plain else tex_box("button_normal.png", 6, 10, 5))
		t.set_stylebox("hover", cls, box(Color(1, 1, 1, 0.05), Color(0, 0, 0, 0), Tokens.RADIUS, 4) if plain else tex_box("button_hover.png", 6, 10, 5))
		t.set_stylebox("pressed", cls, StyleBoxEmpty.new() if plain else tex_box("button_selected.png", 6, 10, 5))
		t.set_stylebox("hover_pressed", cls, box(Color(1, 1, 1, 0.05), Color(0, 0, 0, 0), Tokens.RADIUS, 4) if plain else tex_box("button_pressed.png", 6, 10, 5))
		t.set_stylebox("disabled", cls, StyleBoxEmpty.new() if plain else tex_box("button_disabled.png", 6, 10, 5))
		t.set_stylebox("focus", cls, focus)
		t.set_color("font_color", cls, TEXT)
		t.set_color("font_hover_color", cls, Tokens.GOLD_HI)
		t.set_color("font_pressed_color", cls, Tokens.GOLD_HI)
		t.set_color("font_hover_pressed_color", cls, Tokens.GOLD_HI)
		t.set_color("font_focus_color", cls, TEXT)
		t.set_color("font_disabled_color", cls, Tokens.TEXT_FAINT)
		t.set_color("icon_normal_color", cls, TEXT)
		t.set_color("icon_hover_color", cls, Tokens.GOLD_HI)
		t.set_color("icon_pressed_color", cls, Tokens.GOLD_HI)
		t.set_color("icon_hover_pressed_color", cls, Tokens.GOLD_HI)
		t.set_color("icon_disabled_color", cls, Tokens.TEXT_FAINT)
		t.set_constant("h_separation", cls, 6)
	# a quiet button for icon strips and lists
	t.set_type_variation("FlatButton", "Button")
	t.set_stylebox("normal", "FlatButton", StyleBoxEmpty.new())
	t.set_stylebox("hover", "FlatButton", box(Color(1, 1, 1, 0.06), Color(0, 0, 0, 0), Tokens.RADIUS, 4))
	t.set_stylebox("pressed", "FlatButton", box(Color(Tokens.GOLD, 0.16), Color(Tokens.GOLD, 0.5), Tokens.RADIUS, 4))
	t.set_stylebox("hover_pressed", "FlatButton", box(Color(Tokens.GOLD, 0.22), Color(Tokens.GOLD, 0.6), Tokens.RADIUS, 4))
	t.set_stylebox("disabled", "FlatButton", StyleBoxEmpty.new())
	# check boxes
	var off = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect x="1.5" y="1.5" width="13" height="13" rx="2.5" fill="#15181e" stroke="#9c844f" stroke-width="1.4"/></svg>'
	var on = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect x="1.5" y="1.5" width="13" height="13" rx="2.5" fill="#3a2f1a" stroke="#f0c66e" stroke-width="1.4"/><path d="M4.2 8.3 L7 11 L12 5.2" fill="none" stroke="#ffe3a3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
	for st in ["unchecked", "unchecked_disabled"]:
		t.set_icon(st, "CheckBox", _svg_tex(off, 18))
	for st in ["checked", "checked_disabled"]:
		t.set_icon(st, "CheckBox", _svg_tex(on, 18))
	# tooltips
	t.set_stylebox("panel", "TooltipPanel", tex_box("tooltip.png", 6, 12, 9, true))
	t.set_color("font_color", "TooltipLabel", TEXT)
	t.set_font_size("font_size", "TooltipLabel", 13)
	# separators
	t.set_stylebox("separator", "HSeparator", _line())
	t.set_constant("separation", "HSeparator", 12)
	var vl = StyleBoxLine.new()
	vl.color = Color(BORDER, 0.35)
	vl.vertical = true
	t.set_stylebox("separator", "VSeparator", vl)
	# text entry
	t.set_stylebox("normal", "LineEdit", box(Color(0.04, 0.045, 0.06), Tokens.BORDER_DIM, Tokens.RADIUS, 6))
	t.set_stylebox("focus", "LineEdit", box(Color(0.04, 0.045, 0.06), GOLD, Tokens.RADIUS, 6))
	t.set_color("font_color", "LineEdit", TEXT)
	t.set_color("caret_color", "LineEdit", GOLD)
	t.set_color("selection_color", "LineEdit", Color(GOLD, 0.3))
	# drop-down menus
	t.set_stylebox("panel", "PopupMenu", tex_box("tooltip.png", 6, 6, 6, true))
	t.set_stylebox("hover", "PopupMenu", box(Color(GOLD, 0.16), Color(GOLD, 0.4), 3, 4))
	t.set_color("font_color", "PopupMenu", TEXT)
	t.set_color("font_hover_color", "PopupMenu", Tokens.GOLD_HI)
	t.set_color("font_disabled_color", "PopupMenu", Tokens.TEXT_FAINT)
	t.set_icon("arrow", "OptionButton", _svg_tex('<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><path d="M4 6 L8 10.5 L12 6" fill="none" stroke="#ece3cf" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>', 14))
	# bars and sliders
	var bg_bar = box(Color(0.03, 0.035, 0.045), Color(0.28, 0.25, 0.2), 3, 0)
	var fill = box(GOLD.darkened(0.25), Color(0, 0, 0, 0), 3, 0)
	t.set_stylebox("background", "ProgressBar", bg_bar)
	t.set_stylebox("fill", "ProgressBar", fill)
	t.set_color("font_color", "ProgressBar", TEXT)
	t.set_stylebox("slider", "HSlider", box(Color(0.03, 0.035, 0.045), Tokens.BORDER_DIM, 3, 2))
	t.set_stylebox("grabber_area", "HSlider", box(GOLD.darkened(0.35), Color(0, 0, 0, 0), 3, 2))
	t.set_stylebox("grabber_area_highlight", "HSlider", box(GOLD.darkened(0.15), Color(0, 0, 0, 0), 3, 2))
	var knob = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><circle cx="8" cy="8" r="6.2" fill="#2a2418" stroke="#f0c66e" stroke-width="1.6"/><circle cx="8" cy="8" r="2.2" fill="#f0c66e"/></svg>'
	t.set_icon("grabber", "HSlider", _svg_tex(knob, 16))
	t.set_icon("grabber_highlight", "HSlider", _svg_tex(knob.replace("#2a2418", "#4a3c22"), 16))
	# scroll bars: thin brass rails
	for cls in ["VScrollBar", "HScrollBar"]:
		var track = box(Color(0, 0, 0, 0.25), Color(0, 0, 0, 0), 4, 0)
		track.set_content_margin_all(2)
		t.set_stylebox("scroll", cls, track)
		t.set_stylebox("scroll_focus", cls, track)
		t.set_stylebox("grabber", cls, box(Color(Tokens.BORDER_DIM, 0.9), Color(0, 0, 0, 0), 4, 3))
		t.set_stylebox("grabber_highlight", cls, box(BORDER, Color(0, 0, 0, 0), 4, 3))
		t.set_stylebox("grabber_pressed", cls, box(GOLD, Color(0, 0, 0, 0), 4, 3))
		for ic in ["increment", "increment_highlight", "increment_pressed", "decrement", "decrement_highlight", "decrement_pressed"]:
			t.set_icon(ic, cls, ImageTexture.new())
	t.set_stylebox("panel", "ScrollContainer", StyleBoxEmpty.new())
	return t


static func _line() -> StyleBoxLine:
	var l = StyleBoxLine.new()
	l.color = Color(BORDER, 0.35)
	l.thickness = 1
	return l


static func label(text: String, size: int = 14, colour: Color = TEXT, wrap_width: float = 0.0) -> Label:
	var l = Label.new()
	l.text = text
	l.add_theme_font_size_override("font_size", size)
	l.add_theme_color_override("font_color", colour)
	if wrap_width > 0.0:
		l.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		l.custom_minimum_size.x = wrap_width
	return l


static func tip_label(text: String, tip: String, size: int = 14, colour: Color = TEXT) -> Label:
	var l = label(text, size, colour)
	l.tooltip_text = tip
	l.mouse_filter = Control.MOUSE_FILTER_PASS
	return l


static func button(text: String, callback: Callable, tooltip: String = "") -> Button:
	var b = Button.new()
	b.text = text
	b.tooltip_text = tooltip
	b.focus_mode = Control.FOCUS_NONE
	b.pressed.connect(func(): sfx("click", -6.0))
	b.pressed.connect(callback)
	return b


static func sfx(sound_name: String, volume_db: float = 0.0) -> void:
	## Play a sound effect through the Sound autoload (quietly does nothing if it isn't there).
	var tree := Engine.get_main_loop() as SceneTree
	if tree == null:
		return
	var s = tree.root.get_node_or_null("Sound")
	if s != null:
		s.play(sound_name, volume_db)


static func action(text: String, why: String, callback: Callable, tooltip: String = "") -> Button:
	## A button that is disabled with its reason as the tooltip when `why` isn't empty.
	var b = button(text, callback, why if why != "" else tooltip)
	b.disabled = why != ""
	return b


static func swatch(colour: Color, size: Vector2 = Vector2(16, 16)) -> ColorRect:
	var r = ColorRect.new()
	r.color = colour
	r.custom_minimum_size = size
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return r


static func bar(value: float, max_value: float, width: float = 120.0, colour: Color = GOLD, height: float = 10.0) -> ProgressBar:
	var p = ProgressBar.new()
	p.min_value = 0.0
	p.max_value = maxf(max_value, 0.001)
	p.value = clampf(value, 0.0, p.max_value)
	p.show_percentage = false
	p.custom_minimum_size = Vector2(width, height)
	p.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	p.mouse_filter = Control.MOUSE_FILTER_PASS
	p.add_theme_stylebox_override("fill", box(colour.darkened(0.15), colour.darkened(0.15), 3, 0))
	return p


static func heading(text: String, size: int = 16) -> Label:
	var l = label(text, size, GOLD)
	l.add_theme_font_override("font", Tokens.font("title"))
	return l


static func divider() -> TextureRect:
	## The brass rule with a lozenge, under window titles and section headings.
	var r = TextureRect.new()
	r.texture = load("res://assets/ui/divider.png")
	r.stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.custom_minimum_size = Vector2(0, 11)
	r.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	return r


static func icon(name: String, px: int = 18, tint: Color = TEXT) -> TextureRect:
	return Icons.rect(name, px, tint)


static func icon_button(icon_name: String, text: String, callback: Callable, tooltip: String = "", px: int = 18) -> Button:
	var b = button(text, callback, tooltip)
	b.icon = Icons.tex(icon_name, px)
	b.expand_icon = false
	b.add_theme_constant_override("icon_max_width", px)   # textures are rasterised at 2x
	return b


static func row(children: Array, sep: int = 8) -> HBoxContainer:
	var h = HBoxContainer.new()
	h.add_theme_constant_override("separation", sep)
	for c in children:
		h.add_child(c)
	return h


static func kv(key: String, value: String, tip: String = "", value_colour: Color = TEXT) -> HBoxContainer:
	var k = label(key, 13, TEXT_DIM)
	k.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var v = label(value, 13, value_colour)
	v.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	var h = row([k, v])
	if tip != "":
		h.tooltip_text = tip
		h.mouse_filter = Control.MOUSE_FILTER_PASS
	return h


static func spacer() -> Control:
	var c = Control.new()
	c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return c


static func card(border: Color = Color(), pad: int = 8) -> PanelContainer:
	## A raised surface inside a window. Pass a border colour to mark state (done, ready, locked...).
	var p = PanelContainer.new()
	if border == Color():
		p.theme_type_variation = "CardPanel"
	else:
		var sb = box(BG_CARD, border, Tokens.RADIUS, pad)
		sb.border_width_left = 3
		p.add_theme_stylebox_override("panel", sb)
	return p


static func clear(node: Node) -> void:
	for c in node.get_children():
		node.remove_child(c)
		c.queue_free()


static func signed(v: float, decimals: int = 1) -> String:
	var fmt = "%+." + str(decimals) + "f"
	return fmt % v


static func money(v: float) -> String:
	if absf(v) >= 1000.0:
		return "%.1fk" % (v / 1000.0)
	return "%d" % int(round(v))


static func mod_lines(mods: Dictionary, power_names: Array = []) -> Array:
	## [[text, good?]] for a modifier dictionary.
	var Mod = load("res://scripts/sim/modifiers.gd")
	var out: Array = []
	for k in mods:
		out.append([Mod.describe_one(k, float(mods[k]), power_names), Mod.is_good(k, float(mods[k]))])
	return out


static func mod_box(mods: Dictionary, power_names: Array = [], width: float = 0.0) -> VBoxContainer:
	var v = VBoxContainer.new()
	v.add_theme_constant_override("separation", 0)
	for l in mod_lines(mods, power_names):
		v.add_child(label("  " + l[0], 12, GOOD if l[1] else BAD, width))
	return v
