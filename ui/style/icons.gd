static var _cache := {}


static func tex(name: String, px: int = 20) -> Texture2D:
	var key = "%s@%d" % [name, px]
	if _cache.has(key):
		return _cache[key]
	var src: String = SVG.get(name, SVG["help"])
	var img = Image.new()
	img.load_svg_from_string(src, px * 2.0 / 24.0)
	img.generate_mipmaps()
	var t = ImageTexture.create_from_image(img)
	_cache[key] = t
	return t


static func rect(name: String, px: int = 20, tint: Color = Color.WHITE) -> TextureRect:
	## A TextureRect showing the icon at px x px, tinted.
	var r = TextureRect.new()
	r.texture = tex(name, px)
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	r.custom_minimum_size = Vector2(px, px)
	r.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	r.modulate = tint
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	r.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	return r
